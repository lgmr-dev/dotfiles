{
  "schema": 1,
  "resources": [
    {
      "id": "development",
      "name": "Lint and benchmark tools",
      "description": "Optional tools for contributing to this dotfiles repository",
      "capability": true,
      "category": "Dotfiles development",
      "order": 43,
      "requires": [
        "tool.shellcheck",
        "tool.jq",
        "tool.hyperfine",
        "tool.taplo",
        "tool.yamllint",
        "tool.editorconfig"
      ],
      "scope": "user"
    },
    {
      "id": "tool.shellcheck",
      "name": "ShellCheck",
      "action": "shellcheck",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "shellcheck"
        },
        "linux": {
          "provider": "archive",
          "package": "shellcheck"
        },
        "windows": {
          "provider": "archive",
          "package": "shellcheck"
        }
      },
      "requires": [
        "integration.shells"
      ]
    },
    {
      "id": "tool.jq",
      "name": "jq",
      "action": "jq",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "tool.jq"
        },
        "linux": {
          "provider": "archive",
          "package": "tool.jq"
        },
        "windows": {
          "provider": "archive",
          "package": "tool.jq"
        }
      },
      "requires": [
        "integration.shells"
      ]
    },
    {
      "id": "tool.hyperfine",
      "name": "hyperfine",
      "action": "hyperfine",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "tool.hyperfine"
        },
        "linux": {
          "provider": "archive",
          "package": "tool.hyperfine"
        },
        "windows": {
          "provider": "archive",
          "package": "tool.hyperfine"
        }
      },
      "requires": [
        "integration.shells"
      ],
      "platform_requires": {
        "windows": [
          "tool.vcredist"
        ]
      }
    },
    {
      "id": "tool.taplo",
      "name": "Taplo",
      "action": "taplo",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "taplo"
        },
        "linux": {
          "provider": "archive",
          "package": "taplo"
        },
        "windows": {
          "provider": "archive",
          "package": "taplo"
        }
