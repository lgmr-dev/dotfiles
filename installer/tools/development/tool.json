      "id": "tool.editorconfig",
      "name": "EditorConfig checker",
      "action": "editorconfig",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "editorconfig"
        },
        "linux": {
          "provider": "archive",
