        "tool.git",
        "integration.shells"
      ],
      "action": "archive",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "tool.copilot"
        },
        "linux": {
          "provider": "archive",
          "package": "tool.copilot"
        },
        "windows": {
          "provider": "archive",
          "package": "tool.copilot"
        }
      },
      "platform_requires": {
        "windows": [
          "tool.powershell"
        ]
