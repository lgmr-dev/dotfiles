{
  "schema": 1,
  "resources": [
    {
      "id": "lsd",
      "name": "lsd",
      "description": "File listings with icons and colors",
      "capability": true,
      "category": "Shell essentials",
      "order": 7,
      "requires": [
        "config.lsd",
        "integration.lsd"
      ],
      "scope": "user"
    },
    {
      "id": "tool.lsd",
      "name": "lsd",
      "action": "lsd",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "tool.lsd"
        },
        "linux": {
          "provider": "archive",
          "package": "tool.lsd"
        },
        "windows": {
          "provider": "archive",
          "package": "tool.lsd"
        }
      },
      "requires": [
        "integration.shells"
      ],
      "platform_requires": {
        "windows": [
          "tool.vcredist"
        ]
      }
    },
    {
      "id": "config.lsd",
      "name": "lsd configuration",
      "requires": [
        "tool.lsd"
      ],
      "action": "config",
      "scope": "user"
    },
    {
      "id": "integration.lsd",
      "name": "lsd shell integration",
      "requires": [
        "tool.lsd",
        "integration.shells"
      ],
      "scope": "user"
    }
  ],
  "targets": [
    {
      "resource": "config.lsd",
      "source": "lsd/config.yaml",
      "folder": "config",
      "path": "lsd/config.yaml"
    },
    {
      "resource": "config.lsd",
      "source": "lsd/colors.yaml",
      "folder": "config",
      "path": "lsd/colors.yaml"
    }
  ],
  "shell": [
    {
      "resource": "integration.lsd",
      "shell": "powershell",
      "source": "shell/lsd.ps1"
    }
  ]
}
