{
  "schema": 1,
  "resources": [
    {
      "id": "lazydocker",
      "name": "lazydocker",
      "description": "Terminal UI for Docker and Podman; needs a running Docker engine or the Podman API socket",
      "capability": true,
      "category": "Containers",
      "order": 20,
      "requires": [
        "config.lazydocker"
      ],
      "scope": "user"
    },
    {
      "id": "tool.lazydocker",
      "name": "lazydocker",
      "requires": [
        "integration.shells"
      ],
      "action": "archive",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "tool.lazydocker"
        },
        "linux": {
          "provider": "archive",
          "package": "tool.lazydocker"
        },
        "windows": {
          "provider": "archive",
          "package": "tool.lazydocker"
        }
      }
    },
    {
      "id": "config.lazydocker",
      "name": "lazydocker configuration",
      "requires": [
        "tool.lazydocker"
      ],
      "action": "config",
      "scope": "user"
    }
  ],
  "targets": [
    {
      "resource": "config.lazydocker",
      "source": "lazydocker/config.yml",
      "folder": "home",
      "path": "Library/Application Support/lazydocker/config.yml",
      "platforms": [
        "darwin"
      ]
    },
    {
      "resource": "config.lazydocker",
      "source": "lazydocker/config.yml",
      "folder": "config",
      "path": "lazydocker/config.yml",
      "platforms": [
        "linux"
      ]
    },
    {
      "resource": "config.lazydocker",
      "source": "lazydocker/config.yml",
      "folder": "app_data",
      "path": "lazydocker/config.yml",
      "platforms": [
        "windows"
      ]
    }
  ]
}
