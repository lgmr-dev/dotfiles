      "requires": [
        "tool.gh"
      ],
      "scope": "user"
    },
    {
      "id": "tool.gh",
      "name": "GitHub CLI",
      "requires": [
        "tool.git",
        "integration.shells"
      ],
      "action": "gh",
      "scope": "user",
      "bindings": {
        "darwin": {
          "provider": "archive",
          "package": "tool.gh"
        },
        "linux": {
          "provider": "archive",
          "package": "tool.gh"
        },
        "windows": {
          "provider": "archive",
          "package": "tool.gh"
        }
      }
    }
  ]
}
