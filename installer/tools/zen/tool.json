{
  "schema": 1,
  "resources": [
    {
      "id": "zen",
      "name": "Zen Browser",
      "description": "Web browser; personal profiles remain untouched",
      "capability": true,
      "category": "Desktop apps",
      "order": 39,
      "platforms": [
        "darwin",
        "linux"
      ],
      "scope": "user",
      "platform_requires": {
        "darwin": [
          "app.zen"
        ],
        "linux": [
          "tool.zen",
          "desktop.zen"
        ]
      }
    },
    {
      "id": "tool.zen",
      "name": "Zen Browser",
      "platforms": [
        "linux"
      ],
      "action": "zen",
      "scope": "user",
      "bindings": {
        "linux": {
          "provider": "archive",
          "package": "tool.zen"
        }
      },
      "platform_requires": {
        "linux": [
          "integration.shells",
          "tool.xz",
          "library.libgtk-3-0t64",
          "library.libdbus-glib-1-2",
          "library.libasound2t64",
          "library.libx11-xcb1",
          "library.libxt6t64",
          "library.libstdcxx6"
        ]
      }
    },
    {
      "id": "desktop.zen",
      "name": "Zen Browser launcher",
      "platforms": [
        "linux"
      ],
      "requires": [
        "tool.zen"
      ],
      "action": "desktop",
      "scope": "user"
    },
    {
      "id": "tool.xz",
      "name": "XZ archive decoder",
      "platforms": [
        "linux"
      ],
      "action": "xz",
      "scope": "machine",
      "shared": true,
      "bindings": {
        "linux": {
          "provider": "apt",
          "package": "xz-utils"
        }
      }
    },
    {
      "id": "app.zen",
      "name": "Zen Browser application",
      "description": "Official native app; normal browser updates and personal profiles remain under your control",
      "platforms": [
        "darwin"
      ],
      "action": "package",
      "scope": "machine",
      "requires": [
        "infra.homebrew"
      ],
      "bindings": {
        "darwin": {
          "provider": "homebrew-cask",
          "package": "zen"
        }
      }
    }
  ]
}
